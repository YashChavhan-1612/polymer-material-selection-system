# ============================================================
# Environment Configuration Template
# Copy this file to .env for local development.
# In production (e.g. Render), configure these in your dashboard.
# NEVER commit your actual .env file or production secrets!
# ============================================================

# Flask Secret Key (Required in production, minimum 32 random characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-min-32-chars

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development
FLASK_DEBUG=0

# Database Connection (Option A - Preferred on cloud hosts like Render/Railway/Aiven)
# DATABASE_URL=mysql+pymysql://db_user:db_password@db_host:3306/db_name

# Database Connection (Option B - Discrete parameters, standard for local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=polymer_recommendation_db
DB_USER=root
DB_PASSWORD=your_password_here

# Optional Database Pool Tuning
# DB_POOL_RECYCLE=280
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=10
